# Anthropic API key (console.anthropic.com). Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# Magisterium MCP access token, from your Magisterium account.
MAGISTERIUM_MCP_TOKEN=

# Optional overrides
# MAGISTERIUM_MCP_URL=https://mcp.magisterium.com
# ANTHROPIC_MODEL=claude-opus-5-5
# SMA_EFFORT=medium            # low | medium | high
# SMA_RATE_LIMIT=20            # questions per visitor per 10 minutes
