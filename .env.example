# Anthropic API key (console.anthropic.com). Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# Magisterium developer API key, from your magisterium.com account.
# (MAGISTERIUM_MCP_TOKEN also works, as the older name for the same key.)
MAGISTERIUM_API_KEY=

# Optional overrides
# MAGISTERIUM_API_URL=https://www.magisterium.com/api/v1
# ANTHROPIC_MODEL=claude-opus-5-5
# SMA_EFFORT=medium            # low | medium | high
# SMA_RATE_LIMIT=20            # questions per visitor per 10 minutes
